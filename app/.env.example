# Copy to .env (same folder) — it's loaded automatically and git-ignored.
# The app runs fully without these; they're optional.

# Upgrades the six analysts from data-driven MOCK reasoning to real Claude reasoning.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5   # default; claude-sonnet-5-5 reasons better at ~20x the price
# Hard daily limit on Claude calls (7 per asset per cycle); past it, built-in rules.
# MAX_CLAUDE_CALLS_PER_DAY=2500
# PORT=7100

# How often (minutes) the bot runs a cycle: analyse every asset, update the
# signals, and trade the virtual fund. Each cycle = one debate per asset.
SIGNALS_EVERY_MIN=60

# Optional: company fundamentals (P/E, growth, next earnings date, analyst targets)
# for the stocks. Free key at financialmodelingprep.com (about 250 calls/day).
# FMP_API_KEY=

# Optional: phone push on every flip. Install the ntfy app, subscribe to a
# long random topic name, and put the same name here.
NTFY_TOPIC=

# The virtual-money challenge: starting € and length in days.
# FUND_BASE=1000
# FUND_DAYS=7
# Set off to start challenges with auto-trading paused.
# AUTOTRADE=off
